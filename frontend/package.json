{
  "name": "shortli-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo --port 43179",
    "build": "tsc -b && vite build",
    "build:demo": "tsc -b && vite build --mode demo",
    "lint": "eslint .",
    "test:e2e": "playwright test",
