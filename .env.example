# Перед запуском Docker Compose скопируйте этот файл в .env.
POSTGRES_DB=shortli
POSTGRES_USER=shortli
POSTGRES_PASSWORD=replace-with-a-random-password-at-least-20-chars

# Нестандартные порты позволяют запускать Shortli рядом с другими проектами.
SHORTLI_HTTP_PORT=43176
POSTGRES_HOST_PORT=5001

# Если веб-интерфейс и API используют один домен, укажите одинаковый origin.
PUBLIC_BASE_URL=http://localhost:43176
FRONTEND_ORIGIN=http://localhost:43176
COOKIE_SECURE=false

# Перечислите через запятую только подсети прокси, которые непосредственно
# обслуживают Shortli. Не используйте 0.0.0.0/0 или ::/0.
TRUSTED_PROXY_CIDRS=172.16.0.0/12

# Временно задайте случайный секрет длиной не менее 32 символов, создайте первого
# администратора по инструкции в README, затем очистите значение и перезапустите API.
ADMIN_BOOTSTRAP_TOKEN=

# Ограничения ожидания защищают HTTP-обработчики и PostgreSQL от зависших запросов.
REQUEST_TIMEOUT_SECONDS=10
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_STATEMENT_TIMEOUT_MS=5000
DATABASE_LOCK_TIMEOUT_MS=2000

# Создайте независимые случайные значения. Не используйте пароль базы данных повторно.
ANALYTICS_SALT=replace-with-an-independent-random-value-at-least-32-characters
METRICS_TOKEN=replace-with-a-random-monitoring-token-at-least-24-characters

# Подробная аналитика и обработанные обращения модерации удаляются автоматически.
ANALYTICS_RETENTION_DAYS=365
REPORT_RETENTION_DAYS=180
